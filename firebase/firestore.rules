rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /transactions/{id} {
      allow read, write: if request.auth != null;
    }
    match /inventory/{id} {
      allow read, write: if request.auth != null;
    }
    match /invoice_files/{id} {
      allow read, write: if request.auth != null;
      match /chunks/{chunkId} {
        allow read, write: if request.auth != null;
      }
    }
  }
}
